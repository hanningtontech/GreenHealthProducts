# Firebase — copy to .env and fill from Firebase Console > Project settings > Your apps
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=
FIREBASE_PROJECT_NUMBER=

# Admin bootstrap (do not commit real passwords):
# 1) Create the user in Firebase Authentication (Email/Password)
# 2) Add a Firestore document at admins/{uid} with { email, role: "owner" }
# Media/images are never stored in Firestore — only HTTPS URLs (Backblaze B2).

# Backblaze B2 (S3-compatible) — used by Express server/storage.ts
# Also copy these into functions/.env for Cloud Functions presign (createMediaUploadUrl)
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004
# Public URL prefix, e.g. https://f005.backblazeb2.com/file/your-bucket-name
B2_PUBLIC_BASE_URL=

# Contact / Google Auth branding (implement send later; values already used in UI via reportCopy)
SUPPORT_EMAIL=care@greenhealthproducts.co.ke
GOOGLE_AUTH_SUPPORT_EMAIL=mwendatenzinaomo@gmail.com

# Bulk / transactional SMS — wire later (Africa's Talking / Twilio). Not Firebase Auth OTP.
# SMS_PROVIDER=
# SMS_API_KEY=
# SMS_USERNAME=
# SMS_SENDER_ID=

# Gemini — Cloud Functions ONLY (copy into functions/.env, never the Vite client).
# Setup: https://aistudio.google.com/ → Get API key (free tier) → set GEMINI_API_KEY
# then redeploy functions (not hosting alone). See functions/.env.example.
# Admin Screening Wizard / Content Bank use Gemini only when the bank has no match;
# taught cases stay needs_review until you green-approve. Patients stay bank-only.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
