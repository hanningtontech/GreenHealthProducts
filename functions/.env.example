# Copy to functions/.env (do not commit secrets). Used by createMediaUploadUrl.
#
# Bucket layout written by the function:
#   media/profiles/{uid}/avatar.jpg
#   media/products/{productId}/thumbnail.{ext}
#   media/products/{productId}/gallery/{slot}.{ext}
#   media/screenings/{screeningId}/source/{stamp}_{filename}
#   media/screenings/{screeningId}/reports/patient-report.pdf
#
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=GreenHealthProducts
B2_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
B2_REGION=eu-central-003
B2_PUBLIC_BASE_URL=https://f003.backblazeb2.com/file/GreenHealthProducts
# Bucket must be Public (allPublic). Also raise Caps & Alerts → Download + Class B
# (or set No Cap), otherwise browsers get 403 download_cap_exceeded and images stay blank.

# ---------------------------------------------------------------------------
# Gemini (admin-only generateWellnessReply) — Google AI Studio free tier
# ---------------------------------------------------------------------------
# 1) Open https://aistudio.google.com/ → Get API key (free tier is fine).
# 2) Paste the key below in functions/.env (never in the Vite client /.env).
# 3) Redeploy Cloud Functions:  cd functions && npm run deploy
#    Hosting-only deploy does NOT pick up this key.
# 4) Without a key, the callable still returns a safe non-LLM fallback.
#
# Role in the app: bank answers first; Gemini is used sparingly (admin teach,
# diamond confirm, store-search assist). Server + client rate limits cap usage
# so a free AI Studio key is not burned by traffic spikes.
# Soft caps (Firestore rateLimits/*): ~40 Gemini calls/hour project-wide,
# ~6 store-search AI assists per user/IP/hour, ~20 admin drafts/hour.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
