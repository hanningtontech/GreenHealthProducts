{
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": ["node_modules", ".git", "firebase-debug.log", "firebase-debug.*.log", "*.local"]
    }
  ],
  "hosting": {
    "public": "dist/public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "redirects": [
      { "source": "/admin/", "destination": "/admin", "type": 301 },
      { "source": "/help/", "destination": "/help", "type": 301 },
      { "source": "/profile/", "destination": "/profile", "type": 301 },
      { "source": "/results/", "destination": "/results", "type": 301 }
    ],
    "rewrites": [
      { "source": "/admin", "destination": "/index.html" },
      { "source": "/help", "destination": "/index.html" },
      { "source": "/profile", "destination": "/index.html" },
      { "source": "/results", "destination": "/index.html" },
      { "source": "/results/**", "destination": "/index.html" },
      { "source": "/404", "destination": "/index.html" },
      { "source": "**", "destination": "/index.html" }
    ],
    "headers": [
      {
        "source": "/api/platform/config.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=31536000,immutable"
          }
        ]
      }
    ]
  }
}
